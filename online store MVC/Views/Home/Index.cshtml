@model List<online_store_MVC.Models.Product>

@{
    ViewData["Title"] = "Online Store - Home";
}

<div class="container mt-4">
    <div class="text-center mb-5">
        <h1 class="display-4">Welcome to Our Online Store</h1>
        <p class="lead">Browse our amazing collection of products</p>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var product in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm product-card">
                        <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="height: 250px; object-fit: cover;">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@product.Name</h5>
                            <p class="card-text text-muted small flex-grow-1">@product.Category</p>
                            <p class="card-text fw-bold fs-4 text-primary">$@product.Price.ToString("F2")</p>
                            <div class="d-grid gap-2">
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" 
                                   class="btn btn-outline-primary">View Details</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info text-center" role="alert">
            <h4 class="alert-heading">No products available</h4>
            <p>Please make sure the API is running and try again.</p>
        </div>
    }
</div>

<style>
    .product-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

    .product-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 15px rgba(0,0,0,0.2) !important;
    }
</style>

