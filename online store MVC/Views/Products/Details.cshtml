@model online_store_MVC.Models.Product

@{
    ViewData["Title"] = Model.Name;
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-md-6">
            <img src="@Model.ImageUrl" class="img-fluid rounded shadow" alt="@Model.Name" style="width: 100%; max-height: 500px; object-fit: cover;">
        </div>
        <div class="col-md-6">
            <h1 class="mb-3">@Model.Name</h1>
            
            <div class="mb-3">
                <span class="badge bg-secondary fs-6">@Model.Category</span>
            </div>

            <h2 class="text-primary mb-4">$@Model.Price.ToString("F2")</h2>

            <div class="mb-4">
                <h5>Description</h5>
                <p class="text-muted">@Model.Description</p>
            </div>

            <div class="mb-4">
                <h5>Availability</h5>
                @if (Model.Stock > 0)
                {
                    <p class="text-success">
                        <i class="bi bi-check-circle-fill"></i> In Stock (@Model.Stock units available)
                    </p>
                }
                else
                {
                    <p class="text-danger">
                        <i class="bi bi-x-circle-fill"></i> Out of Stock
                    </p>
                }
            </div>

            <div class="d-grid gap-2 d-md-flex">
                @if (Model.Stock > 0)
                {
                    <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-inline">
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <div class="input-group mb-3">
                            <input type="number" name="quantity" value="1" min="1" max="@Model.Stock" class="form-control" style="max-width: 100px;" />
                            <button class="btn btn-primary btn-lg px-4" type="submit">
                                <i class="bi bi-cart-plus"></i> Add to Cart
                            </button>
                        </div>
                    </form>
                }
                else
                {
                    <button class="btn btn-secondary btn-lg px-5" type="button" disabled>
                        Out of Stock
                    </button>
                }
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-lg">
                    <i class="bi bi-arrow-left"></i> Back to Store
                </a>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12">
            <h3 class="mb-3">Product Information</h3>
            <table class="table table-bordered">
                <tbody>
                    <tr>
                        <th scope="row" class="w-25">Product ID</th>
                        <td>@Model.Id</td>
                    </tr>
                    <tr>
                        <th scope="row">Category</th>
                        <td>@Model.Category</td>
                    </tr>
                    <tr>
                        <th scope="row">Price</th>
                        <td class="text-primary fw-bold">$@Model.Price.ToString("F2")</td>
                    </tr>
                    <tr>
                        <th scope="row">Stock</th>
                        <td>@Model.Stock units</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .breadcrumb {
        background-color: #f8f9fa;
        padding: 0.75rem 1rem;
    }

    .badge {
        padding: 0.5rem 1rem;
    }

    .table th {
        background-color: #f8f9fa;
    }
</style>
